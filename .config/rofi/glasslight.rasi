 * {
    glass-bg:           rgba(15, 15, 15, 0.85);
    top-shimmer:        rgba(255, 255, 255, 0.35);
    text-main:          #ffffff;
    text-dim:           rgba(255, 255, 255, 0.4);
    selection-bg:       rgba(255, 255, 255, 0.1);
    font: "JetBrainsMono Nerd Font 14";
    background-color:   transparent;
    text-color:         @text-main;
}

window {
    width: 650px;
    height: 480px;
    transparency: "real";
    location: center;
    anchor: center;
    border-radius: 20px;
    background-color: @glass-bg;
    background-image: linear-gradient(60deg, rgba(255, 255, 255, 0.15),  rgba(0, 0, 0, 0.1));
    border: 0px 1px 1px 0px; 
    border-color: @top-shimmer;
}


mainbox {
    padding: 0px;
    spacing: 0px;
    children: [ "inputbar", "listview" ];
}


inputbar {
    enabled: true;
    padding: 30px 35px 10px 35px;
    background-color: transparent;
    children: [ "prompt", "entry" ];
}


prompt {
    vertical-align: 0.5;
    margin: 0px 10px 0px 0px;
}


entry {
    vertical-align: 0.5;
    placeholder: "Glasslight Search";
    placeholder-color: @text-dim;
}

listview {
    padding: 10px 25px 25px 25px;
    columns: 1;
    lines: 8;
    fixed-height: false;
    scrollbar: false;
    spacing: 5px;
}

element {
    padding: 10px 15px;
    border-radius: 12px;
    childern: [ "element-icon", "element-text" ];
}

element selected.normal {
    background-color: @selection-bg;
    text-color: #ffffff;
    border: 1px 0px 0px 0px;
    border-color: rgba(255, 255, 255, 0.3);
}


element-icon { size: 24px; margin: 0px 15px 0px 0px; }
element-text { vertical-align: 0.5; text-color: inherit; } 
