    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "hyprshutdown -t 'Logging out...' --post-cmd 'hyprctl dispatch exit'",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "hyprshutdown -t 'Shutting down...' --post-cmd 'poweroff'",
    "text" : "Shutdown",
    "keybind" : "s"
}
{
    "label" : "suspend",
    "action" : "hyprshutdown -t 'Suspending...' --post-cmd 'systemctl suspend'",
    "text" : "Suspend",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "hyprshutdown -t 'Restarting...' --post-cmd 'reboot'",
    "text" : "Reboot",
